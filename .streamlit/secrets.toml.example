[auth]
# Replace with the deployed URL when running outside localhost, for example:
# https://your-app.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"

[auth.google]
client_id = "replace-with-google-client-id"
client_secret = "replace-with-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { scope = "openid profile email" }

[auth.orcid]
client_id = "replace-with-orcid-client-id"
client_secret = "replace-with-orcid-client-secret"
server_metadata_url = "https://orcid.org/.well-known/openid-configuration"
client_kwargs = { scope = "openid" }
